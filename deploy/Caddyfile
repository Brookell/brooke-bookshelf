# Caddy config for the Hong Kong server. __DOMAIN__ is filled in by
# setup-server.sh. Caddy fetches and renews the HTTPS certificates itself.

# The site.
__DOMAIN__ {
	root * /srv/bookshelf
	encode zstd gzip
	file_server

	# Pages and config.js are checked on every visit; everything else is
	# versioned (?v=…) or rarely changes.
	@fresh path / /index.html /admin.html /config.js /manifest.webmanifest
	header @fresh Cache-Control "no-cache"
	header -Server
}

www.__DOMAIN__ {
	redir https://__DOMAIN__{uri} permanent
}

# Supabase, relayed: the browser only talks to api.__DOMAIN__, which works
# in mainland China even when supabase.co is blocked or slow.
api.__DOMAIN__ {
	reverse_proxy https://oipsefmckxyojnntiaax.supabase.co {
		header_up Host oipsefmckxyojnntiaax.supabase.co
	}
	header -Server
}
